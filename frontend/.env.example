# Copy this file to ".env" (same folder) and fill in the values from your
# Appwrite project's web app settings. Never commit the real ".env" file.
#
# Create the database and collection in Appwrite Console first.

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_COLLECTION_ID=your-collection-id
