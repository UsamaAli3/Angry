# Copy this file to ".env" (same folder) and fill in the values from your
# Appwrite project's web app settings. Never commit the real ".env" file.
#
# Create the database and collection in Appwrite Console first.

VITE_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
VITE_APPWRITE_PROJECT_ID=your-project-id
VITE_APPWRITE_DATABASE_ID=your-database-id
VITE_APPWRITE_COLLECTION_ID=your-collection-id
VITE_APPWRITE_SETTINGS_COLLECTION_ID=your-settings-collection-id
# Optional: leave empty to store invitations in the existing check-in collection.
VITE_APPWRITE_INVITATION_COLLECTION_ID=

# Server only. Never prefix these secrets with VITE_ or commit real values.
# Runtime key scopes: tables.read, rows.read, rows.write.
# tables.write is also needed while configuring private table permissions.
APPWRITE_API_KEY=
APPWRITE_ADMIN_USER_ID=
# Stable server-only signing secret; keep the same value when deploying.
INVITATION_LINK_SECRET=
